.DS_Store
__pycache__/
*.pyc
logs/

# model weights — 1.2 GB per full-FT run, never commit
*.pth
*.pt
*.ckpt

# raw imagery is redistributed from the dataset release, not from here
data/amdsd/
data/**/images/
data/**/masks/

# rejected branch: cropping was tested and dropped (see DECISIONS.md)
data/amdsd_features/*_crop.npy

# local experimentation — never committed
.venv/
notebooks/
*.ipynb
.ipynb_checkpoints/
figures/*.png

# generated figures — regenerate with: python figures/make_figures.py
figures/*.pdf
figures/*.png

# AROI licence prohibits redistribution.
data/aroi/
data/**/aroi*
**/AROI*/
*aroi*.npy
*aroi*.png

# generated figures live in subfolders
figures/**/*.pdf
figures/**/*.png
